{
  "name": "chipload",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test \"tests/core/*.test.mjs\" \"tests/calcs/*.test.mjs\"",
    "test:e2e": "node --test tests/e2e/app.test.mjs",
    "test:all": "npm test && npm run test:e2e",
    "serve": "node tests/serve.mjs",
    "vendor": "node scripts/vendor.mjs",
    "build": "node scripts/build-www.mjs",
    "android": "npm run build && npx cap sync android",
    "apk": "npm run android && cd android && gradlew.bat assembleDebug"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "playwright": "1.63.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "cordova-plugin-purchase": "^13.18.0"
  }
}
